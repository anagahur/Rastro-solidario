# ─── Monad testnet ──────────────────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# RPCs de respaldo (separados por comas) si el principal se cae o limita peticiones.
# Por defecto: Ankr y dRPC. Déjalo vacío (MONAD_RPC_RESPALDO=) para no usar respaldo.
# En el navegador el equivalente es VITE_RPC_RESPALDO en frontend/.env.
# MONAD_RPC_RESPALDO=https://rpc.ankr.com/monad_testnet,https://monad-testnet.drpc.org
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://testnet.monadvision.com

# ─── Llaves (NUNCA las subas a git; .env está en .gitignore) ────────────────
# Wallet con MON de testnet (https://faucet.monad.xyz). Despliega, es admin del
# registro de actores y fondea las wallets simuladas.
DEPLOYER_PRIVATE_KEY=

# Mnemónico de las wallets simuladas (fundación, verificadores, proveedores y
# donantes). Genéralo con:  pnpm wallets:nuevo
SIM_MNEMONIC=

# URL pública del frontend (va dentro del NFT de recibo)
FRONTEND_URL=http://localhost:5173/

# ─── Opcionales ─────────────────────────────────────────────────────────────
# Fijar las evidencias (facturas, fotos) en IPFS real con Pinata. Sin esto se
# guardan en evidencias/ con el mismo tipo de CID (bien para una demo desde tu
# computador; para un enlace público, usa Pinata). Pruébalo con:  pnpm pinata
PINATA_JWT=
# Gateway para leer las evidencias. Con Pinata usa tu gateway dedicado
# (https://<tu-gateway>.mypinata.cloud/ipfs/): con pnpm env:monad / env:local el
# navegador las lee directo de IPFS, sin depender del servidor de la app.
IPFS_GATEWAY=
# Bot de Telegram para avisar a los donantes (pnpm notificador). En frontend/.env
# agrega VITE_TELEGRAM_BOT=<usuario_del_bot> para mostrar el botón en la app.
TELEGRAM_BOT_TOKEN=
